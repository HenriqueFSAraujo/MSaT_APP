{
  "compilerOptions": {
    "outDir": "./dist",
    "noEmit": true,
    "allowJs": false,
    "checkJs": false,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "react-jsx",
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "experimentalDecorators": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"], 
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
